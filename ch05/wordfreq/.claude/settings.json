{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "PowerShell(cargo *)",
      "Bash(uv run python automation/compare.py *)",
      "PowerShell(uv run python automation/compare.py *)"
    ],
    "deny": [
      "Edit(/python_src/**)",
      "Edit(/tests/**)",
      "Edit(/contracts/**)",
      "Edit(/automation/**)",
      "Edit(/baseline.lock)",
      "Edit(/pyproject.toml)",
      "Edit(/uv.lock)",
      "Edit(/.python-version)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Bash(git *)",
      "PowerShell(git *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/after_edit.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/before_stop.py"],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
